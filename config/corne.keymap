#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv { acceleration-exponent = <2>; };

/ {
    behaviors {
        mth: mth {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod/Tap/Hold";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&mt LEFT_GUI TAB  &kp Q  &kp W  &kp E         &kp R  &kp T          &kp Y        &kp U  &kp I       &kp O    &kp P       &kp BSPC
&mt LCTRL ESC     &kp A  &kp S  &kp D         &kp F  &kp G          &kp H        &kp J  &kp K       &kp L    &lt 8 SEMI  &mt RCTRL SQT
&kp LSHFT         &kp Z  &kp X  &kp C         &kp V  &kp B          &kp N        &kp M  &kp COMMA   &kp DOT  &kp FSLH    &mth LSHFT ENTER
                                &kp LEFT_ALT  &mo 4  &lt 6 SPACE    &lt 7 SPACE  &mo 5  &lt 3 RALT
            >;
        };

        gaming {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &mo 2   &trans    &trans  &trans  &trans
            >;

            label = "KPU";
        };

        gaming2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &to 0   &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "DTC";
        };

        accents {
            label = "Accents";
            bindings = <
&trans  &kp RA(Q)  &kp RA(W)  &kp RA(E)  &kp RA(N3)  &kp RA(N4)      &kp RA(N7)    &kp RA(U)  &kp RA(N8)  &kp RA(N9)  &kp RA(P)          &trans
&trans  &kp RA(A)  &trans     &trans     &trans      &kp RA(LBRC)    &kp RA(RBRC)  &kp RA(J)  &kp RA(K)   &kp RA(L)   &kp RA(SEMICOLON)  &trans
&trans  &kp RA(A)  &trans     &kp RA(C)  &trans      &trans          &trans        &trans     &trans      &trans      &trans             &trans
                              &trans     &trans      &trans          &trans        &trans     &trans
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TILDE  &kp EXCL        &kp AT          &kp POUND          &kp DLLR         &kp PRCNT     &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &kp DEL
&trans     &kp LS(LC(F1))  &kp LS(LC(F2))  &kp LS(LC(F3))     &kp LS(LC(F4))   &none         &trans     &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE
&trans     &to 1           &trans          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_MUTE    &trans     &trans     &trans    &trans    &trans    &trans
                                           &trans             &trans           &trans        &trans     &trans     &trans
            >;

            label = "Lower";
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp N7     &kp N8     &kp N9            &kp N0             &kp DEL
&trans     &none         &none         &none         &none         &none     &none         &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans     &none         &none         &none         &none         &none     &none         &none      &trans     &trans            &trans             &trans
                                       &trans        &trans        &trans    &trans        &trans     &trans
            >;

            label = "Raise";
        };

        fun {
            label = "Functions";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none     &none         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans        &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none     &none         &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &kp KP_DIVIDE
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none     &none         &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS   &kp KP_MULTIPLY
                         &trans   &trans   &trans    &kp KP_ENTER  &kp KP_NUMBER_0  &kp KP_DOT
            >;
        };

        nav {
            label = "Navigation";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none     &none      &kp PG_UP       &kp UP_ARROW    &kp PAGE_DOWN  &kp INS  &kp DEL
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none     &kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &none    &none
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none     &kp SPACE  &kp END         &none           &none          &none    &trans
                         &trans   &trans   &trans    &trans     &trans          &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &trans    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &msc SCRL_LEFT  &trans          &msc SCRL_RIGHT  &trans    &trans  &trans    &trans    &trans    &trans  &trans
                                &trans          &trans           &trans    &trans  &trans    &trans
            >;

            label = "Mickey";
        };

        adjust {
            bindings = <
&trans      &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4    &kp KP_NUM  &kp CAPSLOCK  &kp SCROLLLOCK  &trans  &kp PRINTSCREEN  &trans
&trans      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4     &trans      &trans        &trans          &trans  &trans           &trans
&bt BT_CLR  &trans         &trans         &trans         &trans         &trans           &trans      &trans        &trans          &trans  &trans           &trans
                                          &trans         &trans         &trans           &trans      &trans        &trans
            >;

            label = "Adjust";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <4 5>;
            then-layer = <9>;
        };
    };
};
