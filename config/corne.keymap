#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&mt LEFT_GUI TAB  &kp Q  &kp W  &kp E         &kp R  &kp T          &kp Y        &kp U  &kp I       &kp O    &kp P       &kp BSPC
&mt LCTRL ESC     &kp A  &kp S  &kp D         &kp F  &kp G          &kp H        &kp J  &kp K       &kp L    &lt 8 SEMI  &mt RCTRL SQT
&kp LSHFT         &kp Z  &kp X  &kp C         &kp V  &kp B          &kp N        &kp M  &kp COMMA   &kp DOT  &kp FSLH    &mt RSHFT ENTER
                                &kp LEFT_ALT  &mo 4  &lt 6 SPACE    &lt 7 SPACE  &mo 5  &lt 1 RALT
            >;
        };

        accents {
            label = "Accents";
            bindings = <
&trans  &kp RA(Q)  &kp RA(W)  &kp RA(E)  &kp RA(N3)  &kp RA(N4)      &kp RA(N7)    &kp RA(U)  &kp RA(N8)  &kp RA(N9)  &kp RA(P)          &trans
&trans  &kp RA(A)  &trans     &trans     &trans      &kp RA(LBRC)    &kp RA(RBRC)  &kp RA(J)  &kp RA(K)   &kp RA(L)   &kp RA(SEMICOLON)  &trans
&trans  &kp RA(A)  &trans     &kp RA(C)  &trans      &trans          &trans        &trans     &trans      &trans      &trans             &trans
                              &trans     &trans      &trans          &trans        &trans     &trans
            >;
        };

        gaming {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &mo 3   &trans    &trans  &trans  &trans
            >;

            label = "KPU";
        };

        gaming2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &to 0   &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "DTC";
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TILDE  &kp EXCL        &kp AT          &kp POUND          &kp DLLR         &kp PRCNT     &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &kp DEL
&trans     &kp LS(LC(F1))  &kp LS(LC(F2))  &kp LS(LC(F3))     &kp LS(LC(F4))   &none         &trans     &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE
&trans     &to 2           &trans          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE    &trans     &trans     &trans    &trans    &trans    &trans
                                           &trans             &trans           &trans        &trans     &trans     &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        fun {
            label = "Functions";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        nav {
            label = "Navigation";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Mickey";
        };

        adjust {
            bindings = <
&trans      &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4    &kp KP_NUM  &kp CAPSLOCK  &kp SCROLLLOCK  &trans  &kp PRINTSCREEN  &trans
&trans      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4     &trans      &trans        &trans          &trans  &trans           &trans
&bt BT_CLR  &trans         &trans         &trans         &trans         &trans           &trans      &trans        &trans          &trans  &trans           &trans
                                          &trans         &trans         &trans           &trans      &trans        &trans
            >;

            label = "Adjust";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <4 5>;
            then-layer = <9>;
        };
    };
};
